# ==========================================
# Torob Seller Backend & Notification Hub
# Configuration Environment Variables
# ==========================================

# Server Host & Port
HOST="0.0.0.0"
PORT="8080"
SECRET_KEY="torob-seller-secret-key-production-change-me-32chars"

# Database Path (Default creates local SQLite in chatapp/backend/chatapp_seller.db)
DATABASE_PATH="chatapp_seller.db"
MAIN_TOROB_DB="../../torob_agent.db"

# Server-Side Inquiry Scheduler Timeouts (in seconds)
# Default flow: 0s (Initial push), 300s (5m reminder), 600s (10m expiration)
INITIAL_PUSH_TIMEOUT_SECONDS=0
REMINDER_TIMEOUT_SECONDS=300
EXPIRATION_TIMEOUT_SECONDS=600

# Firebase Cloud Messaging (FCM HTTP v1)
FCM_ENABLED=true
FCM_PROJECT_ID="torob-seller-app"
# Absolute path to Google Service Account JSON file (Leave empty to use simulated dev mode)
FCM_SERVICE_ACCOUNT_FILE=""

# SMS Provider Gateway for OTP (mock, kavenegar, sms_ir)
# In mock mode, any 5-digit code or default "12345" will verify
SMS_PROVIDER="mock"
SMS_API_KEY=""
MOCK_OTP_CODE="12345"
