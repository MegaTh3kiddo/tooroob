# ==============================================================================
# Torob Intelligence Engine — Environment Configuration Template
# Copy this file to .env and adjust variables for your local development environment.
# ==============================================================================

# Server Runtime
TOROB_ENV=development
TOROB_DEBUG=false
TOROB_HOST=0.0.0.0
TOROB_PORT=8001

# Database & Storage
# In-memory (:memory:) or persistent file path
TOROB_DUCKDB_PATH=:memory:
TOROB_SQLITE_PATH=./data/torob_ledger.db

# Cross-Origin Resource Sharing (CORS)
# Comma-separated list of trusted frontend origins. Never use '*' in production.
TOROB_CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080,http://127.0.0.1:3000,http://127.0.0.1:5173,http://127.0.0.1:8080

# Optional External Integrations (Engine operates seamlessly with built-in fallbacks if omitted)
# 1. External LLM Provider for TorobChat (any OpenAI-compatible /chat/completions API).
#    Fallback: built-in deterministic Persian parser. See docs/LLM_PROVIDERS.md.
#    The LLM only parses constraints and rephrases grounded answers; it never sets prices or stock.
# TOROB_LLM_PROVIDER=openai_compatible        # or: none (force offline mode)
# TOROB_LLM_BASE_URL=https://api.openai.com/v1 # BoxAPI: https://ai.boxapi.ir/ai/v1
# TOROB_LLM_API_KEY=sk-...
# TOROB_LLM_MODEL=gpt-4o-mini
# TOROB_LLM_TIMEOUT_SECONDS=12
# TOROB_LLM_POLISH_REPLIES=true

# 2. Real Road Routing Provider (Fallback: Deterministic arterial road graph + Manhattan-Haversine)
# OSRM_BASE_URL=http://localhost:5000/route/v1/driving

# 3. Merchant SMS/Push Notification Transport (Fallback: SQLite evidence ledger queue)
# SMS_GATEWAY_URL=https://api.sms-provider.internal/v1/send
